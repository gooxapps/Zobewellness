{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|uploads/|pwa-|apple-touch-icon|manifest\\.webmanifest|sw\\.js|workbox-|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
